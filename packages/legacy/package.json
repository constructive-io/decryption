    "@decryption/core": "workspace:*",
    "@decryption/hashes": "workspace:*"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "crypto-js": "^4.2.0",
    "makage": "0.3.0"
  }
}
